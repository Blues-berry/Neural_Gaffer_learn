\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces 问题定义图。该图优先使用 \texttt  {nsniycxi} 的随机面光源失败样例，展示早期分位数高光版本在宽波瓣高光条件下仍存在明显失稳现象，说明仅依赖绝对亮度或粗糙阈值策略不足以稳定高光监督。\relax }}{13}{figure.caption.13}\protected@file@percent }
\newlabel{fig:problem_def_cn}{{5}{13}{问题定义图。该图优先使用 \texttt {nsniycxi} 的随机面光源失败样例，展示早期分位数高光版本在宽波瓣高光条件下仍存在明显失稳现象，说明仅依赖绝对亮度或粗糙阈值策略不足以稳定高光监督。\relax }{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 方法流程图。图中展示了前景优先掩码、局部相对高光计算、blur-only threshold estimation 与图像空间高光引导之间的关系。\relax }}{13}{figure.caption.14}\protected@file@percent }
\newlabel{fig:method_flow_cn}{{6}{13}{方法流程图。图中展示了前景优先掩码、局部相对高光计算、blur-only threshold estimation 与图像空间高光引导之间的关系。\relax }{figure.caption.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 官网风格的 official held-out 展示图。该图将目标环境图作为氛围背景，并将白底重光照结果重新组织为带背景的展示卡片，更适合在摘要页或定性结果开头快速传达方法在 \texttt  {uu}、\texttt  {us} 与 \texttt  {ra} 三个划分上的整体视觉风格。\relax }}{14}{figure.caption.15}\protected@file@percent }
\newlabel{fig:official_teaser_cn}{{7}{14}{官网风格的 official held-out 展示图。该图将目标环境图作为氛围背景，并将白底重光照结果重新组织为带背景的展示卡片，更适合在摘要页或定性结果开头快速传达方法在 \texttt {uu}、\texttt {us} 与 \texttt {ra} 三个划分上的整体视觉风格。\relax }{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces official held-out 结果裁图。三种划分下，本文方法均能较稳定地匹配目标照明外观；其中 \texttt  {ra} 更能体现方法在宽而软高光条件下对镜面区域的改善。\relax }}{14}{figure.caption.16}\protected@file@percent }
\newlabel{fig:official_main_cn}{{8}{14}{official held-out 结果裁图。三种划分下，本文方法均能较稳定地匹配目标照明外观；其中 \texttt {ra} 更能体现方法在宽而软高光条件下对镜面区域的改善。\relax }{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 跨域对比图待补示意位。预留 \texttt  {official}、\texttt  {ecommerce} 与 \texttt  {3D-FUTURE} 三列，每列展示 baseline、本文方法与局部高光放大图；当前该位置仅用于版式规划，不代表跨域结果已全部补齐。\relax }}{14}{figure.caption.17}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 效果-效率对比图。三种设置在随机面光源条件下的结果均能维持基本可用的高光外观，但 hybrid probe distillation 在保持较强 \texttt  {ra} 表现的同时，更适合作为效果与效率折中的辅助方案。\relax }}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:efficiency_vis_cn}{{10}{15}{效果-效率对比图。三种设置在随机面光源条件下的结果均能维持基本可用的高光外观，但 hybrid probe distillation 在保持较强 \texttt {ra} 表现的同时，更适合作为效果与效率折中的辅助方案。\relax }{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces 方法诊断图。图中的高光 mask 与 soft weight 是训练监督可视化，而非推理输出；它们与目标环境图共同展示了前景感知高光监督在训练阶段关注的空间区域。\relax }}{15}{figure.caption.19}\protected@file@percent }
\newlabel{fig:diagnostic_cn}{{11}{15}{方法诊断图。图中的高光 mask 与 soft weight 是训练监督可视化，而非推理输出；它们与目标环境图共同展示了前景感知高光监督在训练阶段关注的空间区域。\relax }{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces 失败案例图。当前方法虽然能够显著提升高光监督稳定性，但在部分极端随机面光源样例中，仍可能出现对宽波瓣高光支持不足的问题。\relax }}{16}{figure.caption.20}\protected@file@percent }
\newlabel{fig:failure_case_cn}{{12}{16}{失败案例图。当前方法虽然能够显著提升高光监督稳定性，但在部分极端随机面光源样例中，仍可能出现对宽波瓣高光支持不足的问题。\relax }{figure.caption.20}{}}
